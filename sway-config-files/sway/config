include cyberpunk

### Startup
#
# Startup Scripts
# caelestia owns the bar, notifications and tray now
# exec_always so `swaymsg reload` restarts the shell too, picking up any
# QML/config patches. The script refuses to restart while the session is locked,
# which would kill the lock client and leave sway showing a dead red screen.
exec_always --no-startup-id ~/.local/bin/caelestia-reload
exec --no-startup-id autotiling

# Polkit authentication agent (needed for fprintd enroll, udisks, etc.)
exec --no-startup-id /usr/lib/polkit-kde-authentication-agent-1

# Clipboard history (text + images)
exec --no-startup-id wl-paste --type text --watch cliphist store
exec --no-startup-id wl-paste --type image --watch cliphist store

# Cursor Style
seat seat0 xcursor_theme cattpuccin-mocha-dark-cursors 28

### Input
#
# Keyboard layout (British)
input type:keyboard {
    xkb_layout "gb"
}

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
set $term kitty
set $browser librewolf
set $bar caelestia shell drawers toggle bar
set $lock ~/.local/bin/lock-screen
set $launcher caelestia shell drawers toggle launcher
set $logout caelestia shell drawers toggle session
set $dashboard caelestia shell drawers toggle dashboard
set $sidebar caelestia shell drawers toggle sidebar
set $files kitty -e yazi
set $ss ~/.local/bin/screenshot
set $notification caelestia shell drawers toggle sidebar
set $clipboard cliphist list | rofi -dmenu -i -p "clip" -config ~/.config/rofi/sway.rasi | cliphist decode | wl-copy
set $clipwipe cliphist wipe

### SwayFX
#
# window corner radius in px
corner_radius 15

# Window background blur
blur on
blur_xray off
blur_passes 3
blur_radius 5

# Oversaturated, slightly crushed CRT look
blur_brightness 0.95
blur_contrast 1.15
blur_saturation 1.35
blur_noise 0.02

# Neon bleed under every window
shadows enable
shadows_on_csd enable
shadow_blur_radius 28

# Frosted panels for the caelestia shell.
# Caelestia asks Hyprland for this via a layerrule, which does nothing here,
# so swayfx has to be told directly. Its bar and drawers share one surface.
layer_effects "caelestia-drawers" blur enable; blur_ignore_transparent enable; shadows enable
shadow_offset 0 0
shadow_color #E455AECC
shadow_inactive_color #1AC5B055

# Glass treatment for the bar, launcher and notifications
layer_effects "rofi" blur enable; shadows enable; corner_radius 16

# inactive window fade amount. 0.0 = no dimming, 1.0 = fully dimmed
default_dim_inactive 0.17
dim_inactive_colors.unfocused #000000FF
dim_inactive_colors.urgent #710100FF

# Move minimized windows into Scratchpad (enable|disable)
scratchpad_minimize disable

### Colors
#
# target                 title     bg    text   indicator  border
client.focused           $pink     $base $text  $pink      $pink
client.focused_inactive  $overlay0 $base $text  $overlay0  $overlay0
client.unfocused         $overlay0 $base $text  $overlay0  $overlay0
client.urgent            $red      $base $peach $red       $red
client.placeholder       $overlay0 $base $text  $overlay0  $overlay0
client.background        $base

### Output configuration
#
output eDP-1 scale 1


focus_follows_mouse yes

### Key bindings
#
# Basics:
#
bindsym $mod+Return exec $term
bindsym Ctrl+Mod1+t exec $term
bindsym $mod+q kill
bindsym $mod+space exec $launcher
bindsym $mod+f exec $browser
bindsym $mod+b exec $bar
bindsym $mod+grave exec $dashboard
bindsym $mod+e exec $files
bindsym $mod+Mod1+l exec $lock
bindsym $mod+n exec $notification
bindsym $mod+v exec $clipboard
bindsym $mod+Shift+v exec $clipwipe


# Drag floating windows by holding down $mod and left mouse button.
# Resize them with right mouse button + $mod.
# Despite the name, also works for non-floating windows.
# Change normal to inverse to use left mouse button for resizing and right
# mouse button for dragging.
floating_modifier $mod normal

# Reload the configuration file
bindsym $mod+Shift+r reload

# Exit sway (logs you out of your Wayland session)
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
bindsym Ctrl+Mod1+Delete exec $logout

# Moving around:
#
# Move your focus around
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move the focused window with the same, but add Shift
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Workspaces:
#
# Switch to workspace
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9

# Move focused container to workspace
bindsym $mod+Mod1+1 move container to workspace number 1
bindsym $mod+Mod1+2 move container to workspace number 2
bindsym $mod+Mod1+3 move container to workspace number 3
bindsym $mod+Mod1+4 move container to workspace number 4
bindsym $mod+Mod1+5 move container to workspace number 5
bindsym $mod+Mod1+6 move container to workspace number 6
bindsym $mod+Mod1+7 move container to workspace number 7
bindsym $mod+Mod1+8 move container to workspace number 8
bindsym $mod+Mod1+9 move container to workspace number 9

# Switch next or previous workspace
bindsym $mod+Ctrl+Left workspace prev_on_output
bindsym $mod+Ctrl+Right workspace next_on_output

# Layout stuff:
#
# Toggle the current focus between tiling and floating mode
bindsym $mod+w floating toggle

# Move the currently focused window to the scratchpad
bindsym $mod+Shift+minus move scratchpad

# If there are multiple scratchpad windows, this command cycles through them.
bindsym $mod+minus scratchpad show

mode "resize" {
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Laptop Lid
bindswitch lid:on exec --no-startup-id $lock

# Volume
bindsym XF86AudioRaiseVolume        exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+ -l 1.0
bindsym XF86AudioLowerVolume        exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05- -l 1.0
bindsym XF86AudioMute               exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute            exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym Shift+XF86AudioRaiseVolume  exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.01+ -l 1.0
bindsym Shift+XF86AudioLowerVolume  exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.01- -l 1.0

# Brightness
bindsym XF86MonBrightnessUp         exec brightnessctl -q s 5%+
bindsym XF86MonBrightnessDown       exec brightnessctl -q s 5%-
bindsym $mod+o exec brightnessctl --device='tpacpi::kbd_backlight' set 1-
bindsym $mod+p exec brightnessctl --device='tpacpi::kbd_backlight' set +1

# Screenshots
bindsym Print exec $ss -c
bindsym Ctrl+Shift+Print exec $ss -s -c
bindsym Ctrl+Print exec $ss
bindsym Shift+Print exec $ss -s
# Same bind starts and stops the recording
bindsym Ctrl+Alt+Print exec $ss -r

# Music config
bindsym $mod+a exec playerctl previous
bindsym $mod+d exec playerctl next
bindsym $mod+s exec playerctl play-pause

### Window Rules
#
# Appearance
default_border pixel 3
gaps inner 5

# caelestia's bar sets its own layer-shell exclusive zone (60px), so sway already
# reserves the bar strip - do NOT add a full-width left gap, it double-counts and
# leaves a dead band. Window x lands at gaps_left + 65, and the bar edge is at 60,
# so left 10 gives a 15px visual gap, matching the top/bottom.
#
# outer must stay >= 12: swayfx (0.6) fails to paint the window border on an
# edge when that edge's clearance from its layer-shell exclusion zone is too
# small (works fine at 12px clearance, breaks at 9px) - only noticeable here
# because caelestia's own top/right/bottom exclusion zones are just
# Config.border.thickness (10px), unlike the bar's much larger left one.
# Tested against swayfx 0.6; re-check this if swayfx is updated.
gaps outer 12
gaps left 10
# Wallpaper is drawn by caelestia's background module
# ~/.local/bin/live-wallpaper still exists if the mpvpaper one is wanted back

# Opacity
for_window [class=".*"] opacity set 0.75
for_window [app_id="gimp*"] opacity set 1.0
for_window [app_id="krita*"] opacity set 1.0
for_window [app_id="org.inkscape.Inkscape"] opacity set 1.0
for_window [app_id="virt-manager"] opacity set 1.0
for_window [app_id="com.obsproject.Studio"] opacity set 1.0

# Blur
for_window [app_id="gimp*"] blur disable
for_window [class="krita*"] blur disable
for_window [app_id="org.inkscape.Inkscape"] blur disable
for_window [app_id="virt-manager"] blur disable
for_window [app_id="com.obsproject.Studio"] blur disable

include /etc/sway/config.d/*
