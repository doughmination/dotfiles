# ~/.ashrc or ~/.dashrc: executed by dash/ash for interactive shells.
# Note: dash/ash is POSIX-compliant and has fewer features than bash

# Set ENV variable to load this file
# Add to ~/.profile: export ENV="$HOME/.ashrc"

# Custom prompt colors (using ANSI escape codes)
PINK="$(printf '\033[38;5;205m')"
PURPLE="$(printf '\033[38;5;135m')"
BLUE="$(printf '\033[38;5;39m')"
BLACK="$(printf '\033[38;5;240m')"
WHITE="$(printf '\033[00m')"
RESET="$(printf '\033[00m')"

# Git prompt function (simplified for POSIX shell)
git_prompt() {
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return
    branch=$(git symbolic-ref --short HEAD 2>/dev/null)
    dirty=""
    git diff --quiet 2>/dev/null || dirty="*"
    printf " [%s%s]" "$branch" "$dirty"
}

# Set prompt (note: dash doesn't support \u, \h, etc.)
# Using environment variables and command substitution
PS1="
${WHITE}↱${PINK}\$(whoami)${WHITE}@${PURPLE}\$(hostname -s) ${BLACK}[\$(pwd)]${WHITE}\$(git_prompt)
${WHITE}↳${BLUE}£ ${RESET}"

# Terminal title (if supported)
case "$TERM" in
xterm*|rxvt*)
    # dash doesn't support PS1 escape sequences, so we update title in prompt
    PS1="$(printf '\033]0;')\$(whoami)@\$(hostname -s): \$(pwd)$(printf '\007')$PS1"
    ;;
esac

# Enable color support for ls (if available)
if [ -x /usr/bin/dircolors ]; then
    eval "$(dircolors -b)"
    alias ls='ls --color=auto'
else
    export CLICOLOR=1
    export LSCOLORS=ExGxBxDxCxEgEdxbxgxcxd
fi

# Aliases
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

# Custom Aliases (Note: dash/ash has limited animation support)
alias sch='printf "Connecting...\n" && ssh clove@ssh.doughmination.win -p 420'
alias sgh='printf "Connecting...\n" && ssh clove@girlsnetwork.dev -p 420'
alias soh='printf "Connecting...\n" && ssh clovid@play.somc.club -p 2022'
alias webtest='rm -rf ~/weblocal/* ~/weblocal/.[!.]* ~/weblocal/..?* && cp -a ~/girlsnetwork.dev/src/. ~/weblocal/ && echo "Synced!"'
alias clreload='git pull && docker compose build --no-cache && docker compose down && docker compose up -d && docker compose logs -f'
alias webreload='git pull && docker compose pull && docker compose up -d'
alias cdd='cd'
alias bashedit='nano ~/.ashrc'
alias bashreload='. ~/.ashrc'

# Run hyfetch on terminal start
if command -v hyfetch >/dev/null 2>&1; then
    hyfetch
fi
