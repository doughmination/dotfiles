# ~/.tcshrc: executed by tcsh for interactive shells.

# If not running interactively, don't do anything
if (! $?prompt) exit

# History settings
set history = 1000
set savehist = (2000 merge)
set histdup = erase

# Custom prompt with colors and git info
# Note: tcsh uses %n for username, %m for hostname, %~ for directory
set PINK = "%{\033[38;5;205m%}"
set PURPLE = "%{\033[38;5;135m%}"
set BLUE = "%{\033[38;5;39m%}"
set BLACK = "%{\033[38;5;240m%}"
set WHITE = "%{\033[00m%}"
set RESET = "%{\033[00m%}"

# Git prompt alias (tcsh doesn't support functions like bash)
alias __git_prompt 'git rev-parse --is-inside-work-tree >& /dev/null && echo -n " [`git symbolic-ref --short HEAD |& grep -v "fatal"`]"'

# Set prompt
set prompt = "\n${WHITE}↱${PINK}%n${WHITE}@${PURPLE}%m ${BLACK}[%~]${WHITE}`__git_prompt`\n${WHITE}↳${BLUE}£ ${RESET}"

# Terminal title
if ($?TERM) then
    if ("$TERM" =~ xterm* || "$TERM" =~ rxvt*) then
        alias precmd 'printf "\033]0;%s@%s: %s\007" "$USER" "`hostname -s`" "$cwd"'
    endif
endif

# Enable color support for ls
setenv CLICOLOR 1
setenv LSCOLORS ExGxBxDxCxEgEdxbxgxcxd

# Aliases
alias ls 'ls --color=auto'
alias ll 'ls -alF'
alias la 'ls -A'
alias l 'ls -CF'
alias grep 'grep --color=auto'
alias fgrep 'fgrep --color=auto'
alias egrep 'egrep --color=auto'

# Custom Aliases
alias sch 'echo "Connecting..." && ssh clove@clovetwilight3.co.uk -p 2525'
alias sgh 'echo "Connecting..." && ssh clove@girlsnetwork.dev -p 420'
alias webtest 'rm -rf ~/weblocal/* ~/weblocal/.[!.]* ~/weblocal/..?* && cp -a ~/girlsnetwork.dev/src/. ~/weblocal/ && echo "Synced!"'
alias clreload 'git pull && docker compose build --no-cache && docker compose down && docker compose up -d && docker compose logs -f'
alias webreload 'git pull && docker compose pull && docker compose up -d'
alias cdd 'cd'
alias bashedit 'nano ~/.tcshrc'
alias bashreload 'source ~/.tcshrc'

# Completion settings
set autolist
set complete = enhance

# Run hyfetch on terminal start
if ( { where hyfetch } ) then
    hyfetch
endif
