{
    "workbench.iconTheme": "catppuccin-mocha",
    "window.zoomLevel": -1,
    "window.commandCenter": true,
    // ==========================================
    // Files
    // ==========================================
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1,
    // ==========================================
    // Explorer
    // ==========================================
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmPasteNative": false,
    "explorer.compactFolders": true,
    "breadcrumbs.enabled": false,
    // ==========================================
    // Git
    // ==========================================
    "git.enabled": true,
    "git.autoRepositoryDetection": "subFolders",
    "git.openRepositoryInParentFolders": "never",
    "git.detectSubmodules": true,
    // ==========================================
    // Unicode
    // ==========================================
    "editor.unicodeHighlight.invisibleCharacters": false,
    "editor.unicodeHighlight.ambiguousCharacters": false,
    // ==========================================
    // Fonts
    // ==========================================
    "editor.fontFamily": "Comic Code, JetBrains Mono, SF Mono, Menlo, Monaco, monospace",
    "editor.fontLigatures": true,
    "editor.fontSize": 13,
    "editor.lineHeight": 22,
    "terminal.integrated.fontFamily": "monospace",
    "terminal.integrated.fontSize": 12,
    // ==========================================
    // Editor
    // ==========================================
    "editor.minimap.enabled": false,
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.semanticHighlighting.enabled": true,
    "editor.inlineSuggest.enabled": true,
    "editor.linkedEditing": true,
    "editor.inlayHints.enabled": "on",
    "editor.matchBrackets": "always",
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    "editor.guides.bracketPairsHorizontal": true,
    "editor.guides.highlightActiveBracketPair": true,
    "editor.guides.indentation": true,
    "editor.guides.highlightActiveIndentation": true,
    "editor.selectionHighlight": true,
    "editor.occurrencesHighlight": "singleFile",
    "editor.hover.delay": 500,
    "editor.renderWhitespace": "selection",
    "editor.renderControlCharacters": false,
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorSurroundingLines": 3,
    "editor.padding.top": 8,
    "editor.padding.bottom": 8,
    "editor.renderLineHighlight": "gutter",
    "editor.smoothScrolling": true,
    "editor.stickyScroll.enabled": false,
    "editor.suggestSelection": "first",
    "editor.acceptSuggestionOnCommitCharacter": false,
    "editor.quickSuggestions": {
        "other": true,
        "comments": false,
        "strings": true
    },
    // ==========================================
    // TypeScript
    // ==========================================
    "typescript.updateImportsOnFileMove.enabled": "always",
    "typescript.preferences.includePackageJsonAutoImports": "on",
    "typescript.inlayHints.parameterNames.enabled": "literals",
    "typescript.inlayHints.parameterTypes.enabled": true,
    "typescript.inlayHints.variableTypes.enabled": true,
    "typescript.inlayHints.propertyDeclarationTypes.enabled": true,
    "typescript.inlayHints.functionLikeReturnTypes.enabled": true,
    "typescript.inlayHints.enumMemberValues.enabled": true,
    // ==========================================
    // JavaScript
    // ==========================================
    "javascript.inlayHints.parameterNames.enabled": "literals",
    "javascript.inlayHints.parameterTypes.enabled": true,
    "javascript.inlayHints.variableTypes.enabled": true,
    "javascript.inlayHints.propertyDeclarationTypes.enabled": true,
    "javascript.inlayHints.functionLikeReturnTypes.enabled": true,
    // ==========================================
    // Emmet
    // ==========================================
    "emmet.includeLanguages": {
        "typescript": "typescriptreact"
    },
    // ==========================================
    // Terminal
    // ==========================================
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.scrollback": 10000,
    // ==========================================
    // Bracket Colors (Tritanopia-friendly)
    // ==========================================
    "workbench.colorCustomizations": {
        "editorBracketHighlight.foreground1": "#F38BA8",
        "editorBracketHighlight.foreground2": "#FAB387",
        "editorBracketHighlight.foreground3": "#F5C2E7",
        "editorBracketHighlight.foreground4": "#CBA6F7",
        "editorBracketHighlight.foreground5": "#CDD6F4",
        "editorBracketHighlight.foreground6": "#9399B2",
        "editorBracketPairGuide.background1": "#F38BA8",
        "editorBracketPairGuide.background2": "#FAB387",
        "editorBracketPairGuide.background3": "#F5C2E7",
        "editorBracketPairGuide.background4": "#CBA6F7",
        "editorBracketPairGuide.background5": "#CDD6F4",
        "editorBracketPairGuide.background6": "#9399B2",
        "editorBracketPairGuide.activeBackground1": "#F38BA8",
        "editorBracketPairGuide.activeBackground2": "#FAB387",
        "editorBracketPairGuide.activeBackground3": "#F5C2E7",
        "editorBracketPairGuide.activeBackground4": "#CBA6F7",
        "editorBracketPairGuide.activeBackground5": "#CDD6F4",
        "editorBracketPairGuide.activeBackground6": "#9399B2"
    },
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "workbench.colorTheme": "Activate UMBRA protocol",
}